# ════════════════════════════════════════════════════════════════════════
# Configuration des sauvegardes Valmere & Co
# ────────────────────────────────────────────────────────────────────────
# Copiez ce fichier en `backup.env` (sans .example) et remplissez les
# valeurs. Le fichier `backup.env` ne doit JAMAIS être committé sur git
# (il contient des mots de passe).
# ════════════════════════════════════════════════════════════════════════

# --- Base de données PostgreSQL (Supabase pooler) -----------------------
DB_HOST=aws-1-us-west-1.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.igzcwqmuwuxdysqftomc
DB_NAME=postgres
DB_PASSWORD=METTRE_LE_MOT_DE_PASSE_DB_ICI

# --- Supabase Storage ---------------------------------------------------
SUPABASE_URL=https://igzcwqmuwuxdysqftomc.supabase.co
SUPABASE_SERVICE_KEY=METTRE_LA_SERVICE_KEY_ICI
SUPABASE_BUCKETS=logos,reports

# --- Chemins locaux -----------------------------------------------------
# Chemin de pg_dump (sur Windows : "C:/Program Files/PostgreSQL/17/bin/pg_dump.exe")
PG_DUMP_PATH=C:/Program Files/PostgreSQL/17/bin/pg_dump.exe

# Dossier racine où sont stockées les sauvegardes
# Recommandation : pointer vers un dossier synchronisé Google Drive ou OneDrive
# Exemple : C:/Users/USERNAME/My Drive/Valmere_Backups
BACKUP_ROOT=C:/Users/rdameus.AIC/Documents/Valmere_Backups
